{
  "version": 2,
  "builds": [
    { "src": "server/vercel.ts", "use": "@vercel/node" },
    { "src": "dist/public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)",         "dest": "server/vercel.ts" },
    { "src": "/bot-webhook-(.*)", "dest": "server/vercel.ts" },
    { "src": "/health",           "dest": "server/vercel.ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)",             "dest": "/dist/public/index.html" }
  ]
}
